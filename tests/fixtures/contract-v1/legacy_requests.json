[
  {
    "id": "capabilities-without-limits",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-capabilities",
      "operation": {"kind": "capabilities"}
    },
    "expect": {
      "status": "COMPLETE",
      "required_operations": ["capabilities", "compile", "materialize", "query", "validate", "rules", "prepare_query"],
      "result_fields": {"default_view": "asserted", "proof_coverage": {"per_fact": "not_recorded"}}
    }
  },
  {
    "id": "prepare-query",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-prepare",
      "operation": {"kind": "prepare_query", "query": "ASK {}"}
    },
    "expect": {"status": "COMPLETE", "result": {"valid": true}}
  },
  {
    "id": "ask-defaults",
    "datasets": ["pack", "full"],
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-ask",
      "operation": {"kind": "query", "dataset": "$DATASET", "query": "ASK {}"}
    },
    "expect": {
      "status": "COMPLETE",
      "result": {
        "query_type": "ASK", "variables": [], "items": [], "boolean": true,
        "view": "asserted", "complete": true, "truncated": false,
        "proof_coverage": {"per_fact": "not_recorded"}
      }
    }
  },
  {
    "id": "plain-literal-normalization",
    "datasets": ["pack", "full"],
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-literal",
      "operation": {
        "kind": "query", "dataset": "$DATASET",
        "query": "SELECT ?label WHERE { <urn:contract:marker> <urn:contract:label> ?label }"
      }
    },
    "expect": {
      "status": "COMPLETE",
      "result": {
        "query_type": "SELECT", "variables": ["label"],
        "items": [{"label": {"type": "literal", "value": "schema", "datatype": "http://www.w3.org/2001/XMLSchema#string"}}],
        "boolean": null, "view": "asserted", "complete": true, "truncated": false,
        "proof_coverage": {"per_fact": "not_recorded"}
      }
    }
  },
  {
    "id": "default-view-excludes-inferred-facts",
    "datasets": ["pack", "full"],
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-asserted",
      "operation": {
        "kind": "query", "dataset": "$DATASET",
        "query": "ASK { <urn:contract:e0000> a <urn:contract:Root> }"
      }
    },
    "expect": {
      "status": "COMPLETE",
      "result": {
        "query_type": "ASK", "variables": [], "items": [], "boolean": false,
        "view": "asserted", "complete": true, "truncated": false,
        "proof_coverage": {"per_fact": "not_recorded"}
      }
    }
  },
  {
    "id": "explicit-closure-view",
    "datasets": ["pack", "full"],
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-closure",
      "operation": {
        "kind": "query", "dataset": "$DATASET", "view": "closure",
        "query": "ASK { <urn:contract:e0000> a <urn:contract:Root> }"
      }
    },
    "expect": {
      "status": "COMPLETE",
      "result": {
        "query_type": "ASK", "variables": [], "items": [], "boolean": true,
        "view": "closure", "complete": true, "truncated": false,
        "proof_coverage": {"per_fact": "not_recorded"}
      }
    }
  },
  {
    "id": "zero-shapes-is-explicit",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-empty-shapes",
      "operation": {"kind": "validate", "dataset": "$DATASET"}
    },
    "expect": {
      "status": "COMPLETE",
      "result_fields": {"conforms": true, "checked_shapes": 0, "violations": 0},
      "report_violations": []
    }
  },
  {
    "id": "named-shape-violation-report",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-violation",
      "operation": {
        "kind": "validate", "dataset": "$DATASET",
        "shapes": [{
          "path": "$SHAPES", "document_id": "legacy-shapes", "format": "turtle",
          "expected_sha256": "$SHAPES_SHA256"
        }]
      }
    },
    "expect": {
      "status": "COMPLETE",
      "result_fields": {"conforms": false, "checked_shapes": 1, "violations": 1},
      "violation_fields": [{
        "focus_node": "urn:contract:e0000", "path": "<urn:legacy:missing>",
        "source_shape": "urn:legacy:property", "shape_ref": "urn:legacy:property",
        "source_constraint_component": "http://www.w3.org/ns/shacl#HasValueConstraintComponent"
      }]
    }
  },
  {
    "id": "unknown-request-field",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-unknown-field",
      "operation": {"kind": "capabilities"},
      "unrecognized": true
    },
    "expect": {"status": "FAILED", "error_code": "INVALID_REQUEST"}
  },
  {
    "id": "missing-required-operation-field",
    "request": {
      "contract": "ontokiln-api/v1",
      "request_id": "legacy-missing-query",
      "operation": {"kind": "query", "dataset": "$DATASET"}
    },
    "expect": {"status": "FAILED", "error_code": "INVALID_REQUEST"}
  }
]
